# ---- server ----
# Legacy shared secret retained for one migration release.
COLUMBIA_PAGES_PASSCODE=change-me-to-a-long-random-secret
# Owner secret used only by the browser control UI.
COLUMBIA_PAGES_ADMIN_PASSCODE=change-me-to-a-different-long-random-secret
# Keep legacy CLI credentials working during migration. Defaults to true.
COLUMBIA_PAGES_ALLOW_LEGACY_AUTH=true
# Device tokens expire after this many days (1..365, default 90).
COLUMBIA_PAGES_TOKEN_TTL_DAYS=90
# Where the SQLite database lives. On Railway, point this at the mounted volume.
DB_PATH=./columbia-pages.db
# Port the server listens on (Railway sets PORT automatically).
PORT=8080
# Published content origin. Required when device authorization is enabled.
PUBLIC_BASE_URL=http://pages.localhost:8080
# Separate API/admin origin. Setting this enables device authorization.
CONTROL_BASE_URL=http://control.localhost:8080

# ---- cli (cpages) ----
# Base URL of the server the CLI talks to.
COLUMBIA_PAGES_URL=http://pages.localhost:8080
# COLUMBIA_PAGES_TOKEN overrides saved tokens. COLUMBIA_PAGES_PASSCODE remains
# available only for explicit legacy migration workflows.
