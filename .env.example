# ---- server ----
# Shared secret required by the JSON API (CLI uploads). Use a long random value.
COLUMBIA_PAGES_PASSCODE=change-me-to-a-long-random-secret
# Where the SQLite database lives. On Railway, point this at the mounted volume.
DB_PATH=./columbia-pages.db
# Port the server listens on (Railway sets PORT automatically).
PORT=8080
# Public base URL used to build shareable links. If unset, it's derived from the
# incoming request. Set it in production to your real domain.
# PUBLIC_BASE_URL=https://columbia-pages.up.railway.app

# ---- cli (cpages) ----
# Base URL of the server the CLI talks to.
COLUMBIA_PAGES_URL=http://localhost:8080
# The CLI reuses COLUMBIA_PAGES_PASSCODE (same value as the server) for auth.
