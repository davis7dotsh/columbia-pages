{
  "name": "columbia-pages-ts",
  "version": "0.1.0",
  "description": "Effect.ts port of Columbia Pages: an Effect-native HTTP server and cpages CLI, built to native binaries with Bun.",
  "type": "module",
  "private": true,
  "scripts": {
    "server": "bun run src/server/main.ts",
    "cpages": "bun run src/cli/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build:server": "bun build --compile --minify --sourcemap src/server/main.ts --outfile bin/server",
    "build:cpages": "bun build --compile --minify --sourcemap src/cli/main.ts --outfile bin/cpages",
    "build": "bun run build:server && bun run build:cpages"
  },
  "dependencies": {
    "@effect/cli": "0.75.2",
    "@effect/platform": "0.96.2",
    "@effect/platform-bun": "0.90.0",
    "@effect/sql": "0.51.1",
    "@effect/sql-sqlite-bun": "0.52.0",
    "effect": "3.21.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
